-- ============================================
-- 01_INSPECTING RAW DATA
-- ============================================

-- 1A. Campaigns
SELECT TOP 10 *
FROM dbo.tbl_campaigns;

SELECT
    COUNT(*)                      AS total_rows,
    COUNT(campaign_id)            AS campaign_id_filled,
    COUNT(campaign_name)          AS campaign_name_filled,
    COUNT(campaign_type)          AS campaign_type_filled,
    COUNT(target_segment)         AS target_segment_filled,
    COUNT(budget)                 AS budget_filled,
    COUNT(impressions)            AS impressions_filled,
    COUNT(clicks)                 AS clicks_filled,
    COUNT(conversions)            AS conversions_filled,
    COUNT(roi)                    AS roi_filled
FROM dbo.tbl_campaigns;

SELECT
    campaign_id,
    COUNT(*) AS duplicate_count
FROM dbo.tbl_campaigns
GROUP BY campaign_id
HAVING COUNT(*) > 1;

-- 1B. Customers
SELECT TOP 10 *
FROM dbo.tbl_customers;

SELECT
    COUNT(*)                      AS total_rows,
    COUNT(customer_id)            AS customer_id_filled,
    COUNT(full_name)              AS full_name_filled,
    COUNT(age)                    AS age_filled,
    COUNT(gender)                 AS gender_filled,
    COUNT(state)                  AS state_filled,
    COUNT(zip_code)               AS zip_code_filled,
    COUNT(registration_date)      AS registration_date_filled,
    COUNT(preferred_channel)      AS preferred_channel_filled
FROM dbo.tbl_customers;

SELECT
    customer_id,
    COUNT(*) AS duplicate_count
FROM dbo.tbl_customers
GROUP BY customer_id
HAVING COUNT(*) > 1;

-- 1C. Interactions
SELECT TOP 10 *
FROM dbo.tbl_interactions;

SELECT
    COUNT(*)                      AS total_rows,
    COUNT(interaction_id)         AS interaction_id_filled,
    COUNT(customer_id)            AS customer_id_filled,
    COUNT(session_id)             AS session_id_filled,
    COUNT(channel)                AS channel_filled,
    COUNT(interaction_type)       AS interaction_type_filled,
    COUNT(duration)               AS duration_filled,
    COUNT(interaction_date)       AS interaction_date_filled
FROM dbo.tbl_interactions;

SELECT
    interaction_id,
    COUNT(*) AS duplicate_count
FROM dbo.tbl_interactions
GROUP BY interaction_id
HAVING COUNT(*) > 1;

-- 1D. Transactions
SELECT TOP 10 *
FROM dbo.tbl_transactions;

SELECT
    COUNT(*)                      AS total_rows,
    COUNT(customer_id)            AS customer_id_filled,
    COUNT(transaction_id)         AS transaction_id_filled,
    COUNT(product_name)           AS product_name_filled,
    COUNT(product_category)       AS product_category_filled,
    COUNT(quantity)               AS quantity_filled,
    COUNT(price)                  AS price_filled,
    COUNT(transaction_date)       AS transaction_date_filled,
COUNT(store_location)             AS store_location_filled,
COUNT(payment_method)             AS payment_method_filled,
    COUNT(discount_applied)       AS discount_filled
FROM dbo.tbl_transactions;

SELECT
    transaction_id,
    COUNT(*) AS duplicate_count
FROM dbo.tbl_transactions
GROUP BY transaction_id
HAVING COUNT(*) > 1;

-- ============================================
-- 02_DATA CLEANING
-- ============================================
-- 2A. Campaigns

DROP TABLE IF EXISTS dbo.Campaigns_Clean;

SELECT
    campaign_id,
    NULLIF(TRIM(campaign_name), '')                                AS campaign_name,
    ISNULL(NULLIF(TRIM(campaign_type), ''), 'Unclassified')        AS campaign_type,
    ISNULL(NULLIF(TRIM(target_segment), ''), 'All Customers')      AS target_segment,
    TRY_CAST(budget AS DECIMAL(12,2))                              AS budget,
    TRY_CAST(impressions AS INT)                                   AS impressions,
    TRY_CAST(clicks AS INT)                                        AS clicks,
    TRY_CAST(conversions AS INT)                                   AS conversions,

    -- conversion_rate recalculated from clicks/conversions where both exist,
    -- rather than trusting a possibly-stale source column
    CASE
        WHEN TRY_CAST(clicks AS INT) > 0
            THEN ROUND(TRY_CAST(conversions AS FLOAT) * 100.0 / TRY_CAST(clicks AS INT), 2)
        ELSE NULL
    END                                                             AS conversion_rate,

    TRY_CAST(start_date AS DATE)                                   AS start_date,
    TRY_CAST(end_date AS DATE)                                     AS end_date,

    -- roi is a given, unverifiable figure — passed through as-is, never recalculated,
    -- since no revenue column exists anywhere in campaign data to check it against
    TRY_CAST(roi AS DECIMAL(10,2))                                 AS roi

INTO dbo.Campaigns_Clean
FROM dbo.tbl_campaigns;

-- 2B. Customers
DROP TABLE IF EXISTS dbo.Customers_Clean;

SELECT
    customer_id,
    NULLIF(TRIM(full_name), '')                                    AS full_name,
    TRY_CAST(age AS INT)                                           AS age,
    ISNULL(NULLIF(TRIM(gender), ''), 'Unknown')                    AS gender,
    NULLIF(TRIM(email), '')                                        AS email,
    NULLIF(TRIM(phone), '')                                        AS phone,
    NULLIF(TRIM(street_address), '')                                AS street_address,
    NULLIF(TRIM(city), '')                                         AS city,
    ISNULL(NULLIF(TRIM(state), ''), 'Unknown')                     AS state,

    -- zip_code reformatted to zero-padded text; if the source stored zip as numeric,
    -- any leading zero was already lost before this step and cannot be recovered here —
    -- this only prevents FURTHER loss going forward
    RIGHT('00000' + CAST(TRY_CAST(zip_code AS INT) AS VARCHAR(5)), 5) AS zip_code,

    TRY_CAST(registration_date AS DATE)                            AS registration_date,
    ISNULL(NULLIF(TRIM(preferred_channel), ''), 'Unknown')         AS preferred_channel

INTO dbo.Customers_Clean
FROM dbo.tbl_customers;

-- 2C. Interactions

DROP TABLE IF EXISTS dbo.Interactions_Clean;

SELECT
    interaction_id,
    customer_id,
    NULLIF(TRIM(session_id), '')                                   AS session_id,
    ISNULL(NULLIF(TRIM(channel), ''), 'Unknown')                   AS channel,
    ISNULL(NULLIF(TRIM(interaction_type), ''), 'Unknown')          AS interaction_type,
    TRY_CAST(duration AS INT)                                      AS duration,
    TRY_CAST(interaction_date AS DATE)                             AS interaction_date,
    page_or_product

INTO dbo.Interactions_Clean
FROM dbo.tbl_interactions;

-- 2D. Transactions

DROP TABLE IF EXISTS dbo.Transactions_Clean;

SELECT
    transaction_id,
    customer_id,
    NULLIF(TRIM(product_name), '')                                   AS product_name,
    ISNULL(NULLIF(TRIM(product_category), ''), 'Unknown')            AS product_category,
    TRY_CAST(quantity AS INT)                                        AS quantity,
    TRY_CAST(price AS DECIMAL(10,2))                                 AS price,
    TRY_CAST(transaction_date AS DATE)                               AS transaction_date,

    -- Splitting store_location into channel_type + city + state 
    -- Reason behind the decision: "Online" and "City, ST" are two different grains in one column
    
    CASE
        WHEN TRIM(store_location) = 'Online' THEN 'Online'
        WHEN TRIM(store_location) LIKE '%,%'  THEN 'In-Store'
        ELSE 'Unknown'
    END AS channel_type,
    CASE
        WHEN TRIM(store_location) LIKE '%,%'
            THEN TRIM(LEFT(store_location, CHARINDEX(',', store_location) - 1))
        ELSE NULL
    END AS store_city,
    CASE
        WHEN TRIM(store_location) LIKE '%,%'
            THEN TRIM(SUBSTRING(store_location, CHARINDEX(',', store_location) + 1, 10))
        ELSE NULL
    END AS store_state,

    ISNULL(NULLIF(TRIM(payment_method), ''), 'Unknown') AS payment_method,

    /*  Impossible impossible discount values are clipped to NULL instead of letting bad data
        flow into Fact table. Genuinely missing discounts are considered as NULL too instead
        of taking the missing discounts as 0 by default.    */

    CASE
        WHEN TRY_CAST(discount_applied AS DECIMAL(5,2)) BETWEEN 0 AND 100
            THEN TRY_CAST(discount_applied AS DECIMAL(5,2))
        ELSE NULL
    END AS discount_applied


INTO dbo.Transactions_Clean
FROM dbo.tbl_transactions;

DROP VIEW IF EXISTS dbo.vw_Transactions_Revenue;
GO

CREATE VIEW vw_Transactions_Revenue AS
SELECT *,
    quantity * price * (1 - ISNULL(discount_applied, 0) / 100.0) AS line_revenue
FROM Transactions_Clean
WHERE quantity IS NOT NULL AND quantity > 0
  AND price IS NOT NULL AND price >= 0;
GO

-- ============================================
-- 03_DATA VALIDATION
-- ============================================

-- 3A. Campaigns
-- Impossible or suspicious numeric values (negative budget, clicks > impressions, etc.)
SELECT campaign_id, campaign_type, budget, impressions, clicks, conversions
FROM dbo.Campaigns_Clean
WHERE budget < 0
   OR impressions < 0
   OR clicks < 0
   OR conversions < 0
   OR clicks > impressions
   OR conversions > clicks;

-- Campaigns with an end_date earlier than their start_date
SELECT campaign_id, start_date, end_date
FROM dbo.Campaigns_Clean
WHERE start_date IS NOT NULL AND end_date IS NOT NULL AND end_date < start_date;

-- Campaigns with zero clicks or zero conversions
-- (not invalid, but these will return NULL not error)
SELECT campaign_id, campaign_type, impressions, clicks, conversions
FROM dbo.Campaigns_Clean
WHERE clicks = 0 OR clicks IS NULL OR conversions = 0 OR conversions IS NULL;

-- Confirm target_segment fallback applied correctly
SELECT target_segment, COUNT(*) AS campaign_count
FROM dbo.Campaigns_Clean
GROUP BY target_segment
ORDER BY campaign_count DESC;

-- 3B. Customers
-- Age outside a plausible human range
SELECT customer_id, age
FROM dbo.Customers_Clean
WHERE age IS NOT NULL AND (age < 0 OR age > 110);

-- zip_code didn't come out as exactly 5 characters after padding
SELECT customer_id, zip_code
FROM dbo.Customers_Clean
WHERE LEN(zip_code) <> 5;

-- Confirm state fallback applied correctly
SELECT state, COUNT(*) AS customer_count
FROM dbo.Customers_Clean
GROUP BY state
ORDER BY customer_count DESC;

-- 3C. Interactions
-- Interactions with no matching customer (to be excluded from FactInteractions)
SELECT COUNT(*) AS orphaned_interactions
FROM dbo.Interactions_Clean i
LEFT JOIN dbo.Customers_Clean c ON i.customer_id = c.customer_id
WHERE c.customer_id IS NULL;

-- Confirm channel and interaction_type fallbacks applied correctly
SELECT channel, interaction_type, COUNT(*) AS interaction_count
FROM dbo.Interactions_Clean
GROUP BY channel, interaction_type
ORDER BY interaction_count DESC;

-- 3D. Transactions
-- Checking for orphaned customers
SELECT COUNT(*) AS orphaned_transactions
FROM dbo.Transactions_Clean t
LEFT JOIN dbo.Customers_Clean c ON t.customer_id = c.customer_id
WHERE c.customer_id IS NULL;

-- Checking for invalid/missing quantities (to be excluded from FactTransactions)
SELECT *
FROM dbo.Transactions_Clean
WHERE quantity IS NULL OR quantity <= 0;

-- Checking for invalid/missing prices (also to be excluded from FactTransactions)
SELECT *
FROM dbo.Transactions_Clean
WHERE price IS NULL OR price < 0;

-- Confirm that the store_location split worked correctly
SELECT TOP 20 channel_type, store_city, store_state
FROM dbo.Transactions_Clean
WHERE channel_type = 'In-Store';
